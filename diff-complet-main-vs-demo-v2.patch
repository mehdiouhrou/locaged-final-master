+}
+
+/* ----- Actions principales (rouge maquette) ----- */
+body.locaged-v2 .btn-upload,
+body.locaged-v2 .btn.btn-upload {
+  background: linear-gradient(135deg, #cc2929 0%, #a61f24 100%) !important;
