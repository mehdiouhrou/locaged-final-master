+            $process->run();
+
+            if (! $process->isSuccessful()) {
+                Log::warning('pdftoppm failed: '.$process->getErrorOutput());
+
+                return '';
+            }
+
+            $paths = glob($prefix.'-*.png') ?: [];
+            if ($paths === []) {
+                $paths = glob($prefix.'*.png') ?: [];
+            }
+            natsort($paths);
+            $paths = array_values($paths);
+
+            $fullText = '';
