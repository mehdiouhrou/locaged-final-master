+
+body.locaged-v2 .sidebar .submenu {
+  border-inline-start-color: rgba(204, 41, 41, 0.2);
+  background: rgba(248, 250, 252, 0.65);
+  border-radius: 0 8px 8px 0;
+}
+
+body.locaged-v2 .sidebar .submenu li a:hover,
+body.locaged-v2 .sidebar .submenu li a.active {
+  background: var(--lgv2-brand-soft);
+  color: var(--lgv2-brand-dark) !important;
+}
+
+body.locaged-v2 .layout-with-sidebar {
+  --sidebar-width: clamp(232px, 18vw, 300px);
+}
+
+/* ----- Zone principale + header ----- */
+body.locaged-v2 .main-content {
+  background: transparent;
+}
+
+body.locaged-v2 .header {
+  background: transparent;
+  border: 0;
+  border-radius: 0;
+  margin: 0.5rem clamp(8px, 1.5vw, 16px) 1rem 0;
+  padding: 0.6rem 1rem;
+  box-shadow: none;
+}
+
+body[dir='rtl'].locaged-v2 .header {
+  margin-left: 0;
+  margin-right: clamp(8px, 1.5vw, 16px);
+}
+
+body.locaged-v2 .header .search-box input {
+  background: #f9fafb;
+  border: 1px solid #e5e7eb !important;
+  border-radius: 10px;
+}
+
+
+body.locaged-v2 .username {
+  color: var(--lgv2-muted) !important;
+}
+
+body.locaged-v2 .user-avatar {
+  border-left-color: #e5e7eb !important;
+}
+
+body.locaged-v2 .pop,
+body.locaged-v2 .language {
+  border-radius: var(--lgv2-radius);
+  border: 1px solid var(--lgv2-border);
+  box-shadow: var(--lgv2-shadow);
+}
+
+body.locaged-v2 .pop h3,
+body.locaged-v2 .pop h4 {
