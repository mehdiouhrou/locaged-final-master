+}
+
+body.locaged-v2 .user-info .name {
+  color: #111827;
+}
+
+body.locaged-v2 .user-info .role {
+  color: var(--lgv2-muted);
+}
+
+/* Tableaux & listes (Livewire / vues métier) */
+body.locaged-v2 .table {
+  --bs-table-bg: transparent;
+}
+
+body.locaged-v2 .table thead th {
+  font-size: 0.72rem;
+  font-weight: 700;
+  letter-spacing: 0.06em;
+  text-transform: uppercase;
+  color: var(--lgv2-muted);
+  border-bottom-color: var(--lgv2-border);
+  background: rgba(249, 250, 251, 0.9);
+}
+
+body.locaged-v2 .table tbody tr:hover {
