+  --lgv2-brand-soft: rgba(204, 41, 41, 0.1);
+  --lgv2-ink: #1a1a1a;
+  --lgv2-body-text: #2d3748;
+  --lgv2-muted: #6b7280;
+  --lgv2-muted-strong: #4a5568;
+  --lgv2-border: rgba(26, 26, 26, 0.08);
+  --lgv2-shadow: 0 10px 40px rgba(17, 24, 39, 0.06);
+  --lgv2-radius: 12px;
+  --lgv2-radius-lg: 16px;
+  --lgv2-row-selected: #fff0f3;
+  --lgv2-hero-bg: #f3f4f6;
+  --lgv2-hero-border: rgba(26, 26, 26, 0.1);
+  --lgv2-file-pdf-bg: #ffe4e6;
+  --lgv2-file-pdf-text: #9f1239;
+  --lgv2-file-doc-bg: #dbeafe;
+  --lgv2-file-doc-text: #1e40af;
+  --lgv2-file-xls-bg: #d1fae5;
+  --lgv2-file-xls-text: #065f46;
+  --lgv2-file-img-bg: #fef3c7;
+  --lgv2-file-img-text: #92400e;
+
+  background: var(--lgv2-bg) !important;
+  color: var(--lgv2-ink);
+}
+
+body.locaged-v2,
+body.locaged-v2 .btn,
+body.locaged-v2 .form-control {
+  font-family:
+    'Inter',
+    system-ui,
+    -apple-system,
+    'Segoe UI',
+    Roboto,
+    Helvetica,
+    Arial,
+    sans-serif !important;
+  font-size: 14px;
+}
+
+body.locaged-v2 .lgv2-label-caps,
+body.locaged-v2 .card.lgv2-document-side .card-header {
+  font-size: 11px;
+  font-weight: 700;
+  letter-spacing: 0.08em;
+  text-transform: uppercase;
+  color: var(--lgv2-muted);
+}
+
+/* ----- Marque (logo + sous-titre) ----- */
+body.locaged-v2 .sidebar-brand-sub {
+  font-size: 0.65rem;
+  letter-spacing: 0.12em;
+  text-transform: uppercase;
+  color: var(--lgv2-muted);
+  margin-top: 0.15rem;
+  line-height: 1.2;
+}
+
+body.locaged-v2 .sidebar.collapsed .sidebar-brand-sub {
+  display: none;
+}
+
+body.locaged-v2 .sidebar.collapsed .sidebar-section-label {
+  display: none;
+}
+
+body.locaged-v2 .sidebar-section-label {
+  list-style: none;
+  margin: 1.25rem 0 0.35rem 1rem;
+  padding: 0;
+  pointer-events: none;
+}
+
+body.locaged-v2 .sidebar-section-label .sidebar-section-label-text {
+  font-size: 0.68rem;
+  font-weight: 700;
+  letter-spacing: 0.14em;
+  color: #9ca3af;
+  text-transform: uppercase;
+}
+
+/* ----- Sidebar claire (maquette) ----- */
+body.locaged-v2 .sidebar {
+  background: #ffffff;
+  box-shadow: 4px 0 24px rgba(15, 23, 42, 0.06);
+  border-right: 1px solid var(--lgv2-border);
+  background-image: none !important;
+}
+
+body[dir='rtl'].locaged-v2 .sidebar {
+  border-right: none;
+  border-left: 1px solid var(--lgv2-border);
+  box-shadow: -4px 0 24px rgba(15, 23, 42, 0.06);
+}
