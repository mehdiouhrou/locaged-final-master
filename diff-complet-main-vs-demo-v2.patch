+body.locaged-v2 .sidebar a {
+  color: var(--lgv2-ink) !important;
+}
+
+body.locaged-v2 .sidebar-menu > li > a {
+  border: 1px solid transparent;
+  border-inline-start: 4px solid transparent;
+}
+
+body.locaged-v2 .sidebar-menu > li > a:hover {
