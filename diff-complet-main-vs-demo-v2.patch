+        'toDate' => ['except' => null, 'as' => 'to'],
+    ];
+
+    public function render(): View
+    {
+        $user = auth()->user();
+        $visibleDocumentIds = Document::query()->select('documents.id');
+
+        $categories = Category::query()
+            ->whereIn('id', Document::query()->select('category_id')->whereNotNull('category_id'))
+            ->orderBy('name')
+            ->get(['id', 'name']);
+
