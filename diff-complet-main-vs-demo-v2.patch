+            'mysql', 'mariadb' => "YEAR({$column})",
+            'sqlite' => "CAST(strftime('%Y', {$column}) AS INTEGER)",
+            'pgsql' => "CAST(EXTRACT(YEAR FROM {$column}) AS INTEGER)",
+            default => "CAST(strftime('%Y', {$column}) AS INTEGER)",
+        };
+    }
