@@ -0,0 +1,1280 @@
+// =============================================================================
+// LocaGed V2 — alignement maquette Locarchives (sidebar claire + rouge)
+// (différent de l’ancienne variante « rail sombre + teal ».)
+// =============================================================================
+
+body.locaged-v2 {
+  --lgv2-bg: #f4f5f7;
