# ─────────────────────────────────────────────────────────────────────────────
# Erreur serveur / 500 au premier lancement ?
#   1) Avoir un fichier .env à la racine : cp .env.example .env
#   2) Clé d’application obligatoire : php artisan key:generate
#      (si APP_KEY est vide ou absent, Laravel lève MissingAppKeyException.)
# En local : APP_ENV=local APP_DEBUG=true APP_URL=http://127.0.0.1:8000
# ─────────────────────────────────────────────────────────────────────────────

APP_NAME=LocaGed
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://www.locaged.com
ASSET_URL=https://www.locaged.com

# Développement local : `php artisan serve` (port 8000 par défaut)
# → http://127.0.0.1:8000  |  connexion : http://127.0.0.1:8000/login  |  profils V2 : http://127.0.0.1:8000/access-profiles
# Pour l’API Sanctum : même origine ou Bearer token ; domaines stateful dans config/sanctum.php (localhost, 127.0.0.1:8000, …)


APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=locaged
DB_USERNAME=root
DB_PASSWORD=Locaged@2025.

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
AUTH_ENFORCE_SENSITIVE_ROLES_MFA=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Files d’attente : `database` suffit pour les jobs sans Horizon. Pour Laravel Horizon (dashboard /horizon),
# utiliser Redis et lancer le superviseur : `php artisan horizon` (voir config/horizon.php).
QUEUE_CONNECTION=database
# Exemple avec Horizon : QUEUE_CONNECTION=redis

CACHE_STORE=database
# CACHE_PREFIX=

SCOUT_DRIVER=typesense
TYPESENSE_API_KEY=xyz
TYPESENSE_HOST=localhost
TYPESENSE_PORT=8108
TYPESENSE_PROTOCOL=http
TYPESENSE_PATH=

# LocaGed V2 — visibilité des DOCUMENTS (global scope sur Document), pas le choix des catégories en liste :
#   legacy = règles historiques par rôle (pôle / sous-département / service du document et du user).
#   profile = documents visibles si leur category_id (ou sous-catégorie) est dans les catégories
#             accessibles via ProfileCategoryAccessService (profiles, profile_user, profile_service, profile_category).
# Les catégories en base sont sans pôle/département sur la ligne ; l’upload déduit pôle/service du compte.
# Passer à profile quand les profils et profile_category sont prêts. Retour arrière : legacy.
GED_CATEGORY_ACCESS_DRIVER=profile
# Règles workflow — laisser false jusqu’à backfill des règles par département (voir docs/workflow-rules-deployment.md)
GED_ENFORCE_WORKFLOW_RULES=false

# ─── Déploiement / recette (ordre recommandé) ───────────────────────────────
# 1) php artisan migrate
# 2) php artisan db:seed --class=RolesAndPermissionsSeeder
# 3) Optionnel avant GED_ENFORCE_WORKFLOW_RULES=true : php artisan ged:seed-default-workflow-rules
# 4) Smoke : connexion, approbation/refus document, module destructions / PV, Horizon (/horizon) si Redis

# File dédiée aux jobs OCR (Horizon). Doit correspondre au superviseur `supervisor-ocr` dans config/horizon.php
OCR_QUEUE=default

# Audit retention policy
AUDIT_LOG_RETENTION_MONTHS=6
AUDIT_DESTROY_RETENTION_YEARS=30
AUDIT_HMAC_KEY=
AUDIT_EVIDENCE_PRIVATE_KEY=
AUDIT_EVIDENCE_PUBLIC_KEY=
AUDIT_WORM_ENABLED=false
AUDIT_WORM_DISK=s3
AUDIT_WORM_PREFIX=audit-evidence/
AUDIT_WORM_MODE=COMPLIANCE
AUDIT_WORM_RETENTION_YEARS=10

# ClamAV : analyse après sélection des fichiers (upload Livewire). Nécessite `clamscan` sur le serveur.
CLAMAV_ENABLED=false
CLAMAV_BINARY=clamscan

# NGINX PORT
NGINX_PORT=80


MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ── Uploads / erreur 413 (nginx) sur logos (localisation & marque) ─────────
# Ubuntu nginx par défaut : client_max_body_size 1m → trop petit pour images 5–8 Mo.
# Dans le bloc server { } du vhost du site :
#   client_max_body_size 20M;
# Puis : sudo nginx -t && sudo systemctl reload nginx
# PHP-FPM : upload_max_filesize et post_max_size ≥ 12M (php.ini ou pool .conf)

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1
PUSHER_HOST=
PUSHER_PORT=
PUSHER_SCHEME=https
PUSHER_ENCRYPTED=true

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"